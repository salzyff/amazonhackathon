NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase server secret key (or the legacy service_role key). Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
# Optional: a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternative: Vercel AI Gateway. Gemini takes priority when both are set.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
